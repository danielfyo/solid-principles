# =============================================================================
# Root .gitignore — shared rules for the whole repository.
# Language-specific rules live next to each project:
#   dotnet/.gitignore      (.NET / Visual Studio / Rider)
#   python/.gitignore      (Python)
#   go/.gitignore          (Go)
#   typescript/.gitignore  (Node.js / TypeScript)
#   react/.gitignore       (Node.js / Vite / React)
# =============================================================================

# --- Operating systems -------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
.directory
.Trash-*

# --- Editors and IDEs --------------------------------------------------------
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/
*.swp
*.swo
*.sublime-workspace
.fleet/

# --- Secrets and local environment -------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- Logs and temporary files ------------------------------------------------
*.log
*.tmp
*.temp
/tmp/
/temp/
