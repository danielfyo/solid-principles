{
  "name": "solid-principles-react",
  "version": "1.0.0",
  "private": true,
  "description": "SOLID principles applied to React components, hooks and context.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
