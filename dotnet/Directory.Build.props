<Project>
  <!-- Shared settings for every project in the solution. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML comments. Examples document intent in prose instead. -->
    <!-- CA1515/CA1724/CA1822/CA1848: noise for teaching code (public types, short names, static suggestions, logging). -->
    <NoWarn>$(NoWarn);CS1591;CA1515;CA1724;CA1822;CA1848</NoWarn>
  </PropertyGroup>
</Project>
